package templates

import (
	"testcharting/templates/utils"
)

templ AppHead() {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Chart Testing App</title>
		// CDN Links
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/echarts@6.0.0/dist/echarts.min.js"></script>
		// Configurations
		<script>
			tailwind.config = {
				darkMode: 'class',
			}
		</script>
	</head>
}

templ MainApp() {
	<!DOCTYPE html>
	<html>
		@AppHead()
		<body class="p-6 bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100">
			<div hx-get="/projects" hx-target="this" hx-swap="outerHTML" hx-trigger="load">
				@templates_utils.LoadingSpinner("Loading chart projects...")
			</div>
		</body>
	</html>
}
