package templates_scripts

// Scripts for templates/chartproject/*

templ ApplyLogFiltersScript() {
	<script>
		function applyLogLevelFilters() {
			// Get all inactive filter levels
			const inactiveButtons = document.querySelectorAll('.log-filter-btn.log-filter-inactive');
			const inactiveLevels = Array.from(inactiveButtons).map(btn => btn.getAttribute('data-log-filter'));
			
			// Show/hide log entries based on active filters
			const allLogEntries = document.querySelectorAll('.log-entry');
			allLogEntries.forEach(entry => {
				const logLevel = entry.getAttribute('data-log-level');
				entry.classList.toggle('hidden', inactiveLevels.includes(logLevel));
			});
		}
	</script>
}
