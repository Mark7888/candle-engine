package templates_charts

import (
	"testcharting/pkg/charting/chartproject/echarts"
	"github.com/google/uuid"
)

templ ChartRender(echartOptions echarts.EchartsOptions) {
	{{ id := "chart-" + uuid.New().String() }}
	<div data-chart-render id={ id }></div>
	@chartRenderScript(id, echartOptions)
	@chartDimensionFixScript(id)
}
