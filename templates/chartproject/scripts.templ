package templates_chartproject

// Collection scripts

script switchTabScript(index int) {
	document.querySelectorAll('[id^="project-tab-content-"]').forEach((el, i) => {
		el.classList.toggle('hidden', i !== index);
	});
	document.querySelectorAll('[id^="project-tab-button-"]').forEach((btn, i) => {
		if (i === index) {
			btn.classList.remove('border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300', 'dark:text-gray-400', 'dark:hover:text-gray-300', 'dark:hover:border-gray-600');
			btn.classList.add('border-indigo-500', 'text-indigo-600', 'dark:border-indigo-400', 'dark:text-indigo-400');
		} else {
			btn.classList.remove('border-indigo-500', 'text-indigo-600', 'dark:border-indigo-400', 'dark:text-indigo-400');
			btn.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300', 'dark:text-gray-400', 'dark:hover:text-gray-300', 'dark:hover:border-gray-600');
		}
	});
}

// Project scripts

script switchPairTabScript(containerId string, index int) {
	const container = document.getElementById(containerId);
	container.querySelectorAll('[data-pair-content]').forEach((el, i) => {
		el.classList.toggle('hidden', i !== index);
	});
	container.querySelectorAll('[data-pair-tab]').forEach((btn, i) => {
		if (i === index) {
			btn.classList.remove('bg-transparent', 'text-gray-600', 'hover:bg-gray-100', 'dark:text-gray-400', 'dark:hover:bg-gray-700');
			btn.classList.add('bg-indigo-100', 'text-indigo-700', 'dark:bg-indigo-900', 'dark:text-indigo-300');
		} else {
			btn.classList.remove('bg-indigo-100', 'text-indigo-700', 'dark:bg-indigo-900', 'dark:text-indigo-300');
			btn.classList.add('bg-transparent', 'text-gray-600', 'hover:bg-gray-100', 'dark:text-gray-400', 'dark:hover:bg-gray-700');
		}
	});
}

script toggleLogsPanelScript() {
	// Get all panels to check current state
	const logsPanels = document.querySelectorAll('[data-logs-panel]');
	const collapsedBars = document.querySelectorAll('[data-collapsed-bar]');
	const mainContents = document.querySelectorAll('[data-main-content]');
	
	// Check if any panel is currently hidden (closed state)
	const isAnyClosed = Array.from(logsPanels).some(panel => panel.classList.contains('hidden'));
	
	if (isAnyClosed) {
		// Open all logs panels
		logsPanels.forEach(panel => panel.classList.remove('hidden'));
		collapsedBars.forEach(bar => bar.classList.add('hidden'));
		mainContents.forEach(content => {
			content.classList.remove('lg:w-full');
			content.classList.add('lg:w-2/3');
		});
		localStorage.setItem('logsPanelOpen', 'true');
	} else {
		// Close all logs panels
		logsPanels.forEach(panel => panel.classList.add('hidden'));
		collapsedBars.forEach(bar => bar.classList.remove('hidden'));
		mainContents.forEach(content => {
			content.classList.remove('lg:w-2/3');
			content.classList.add('lg:w-full');
		});
		localStorage.setItem('logsPanelOpen', 'false');
	}
}

script syncLogsPanelState() {
	// Get the saved state from localStorage, or check existing panels
	const savedPanelState = localStorage.getItem('logsPanelOpen');
	let isPanelHidden;
	
	if (savedPanelState !== null) {
		// Use saved state
		isPanelHidden = savedPanelState === 'false';
	} else {
		// Fall back to checking existing panels
		const existingPanels = document.querySelectorAll('[data-logs-panel]');
		if (existingPanels.length === 0) return;
		isPanelHidden = existingPanels[0].classList.contains('hidden');
	}
	
	// Apply this state to all panels
	const allLogsPanels = document.querySelectorAll('[data-logs-panel]');
	const allCollapsedBars = document.querySelectorAll('[data-collapsed-bar]');
	const allMainContents = document.querySelectorAll('[data-main-content]');
	
	allLogsPanels.forEach(panel => {
		if (isPanelHidden) {
			panel.classList.add('hidden');
		} else {
			panel.classList.remove('hidden');
		}
	});
	
	allCollapsedBars.forEach(bar => {
		if (isPanelHidden) {
			bar.classList.remove('hidden');
		} else {
			bar.classList.add('hidden');
		}
	});
	
	allMainContents.forEach(content => {
		if (isPanelHidden) {
			content.classList.remove('lg:w-2/3');
			content.classList.add('lg:w-full');
		} else {
			content.classList.remove('lg:w-full');
			content.classList.add('lg:w-2/3');
		}
	});
}

script onLogTypeChangeScript(panelId string, selectId string) {
	const panel = document.getElementById(panelId);
	const select = document.getElementById(selectId);
	const selectedType = select.value;
	
	// Find all log collections and empty state within this panel
	const logCollections = panel.querySelectorAll('[data-log-collection]');
	const emptyState = panel.querySelector('[data-log-empty]');
	
	if (selectedType === '') {
		// Show empty state, hide all collections
		if (emptyState) emptyState.classList.remove('hidden');
		logCollections.forEach(collection => {
			collection.classList.add('hidden');
		});
	} else {
		// Hide empty state, show selected collection
		if (emptyState) emptyState.classList.add('hidden');
		logCollections.forEach(collection => {
			if (collection.getAttribute('data-log-collection') === selectedType) {
				collection.classList.remove('hidden');
			} else {
				collection.classList.add('hidden');
			}
		});
	}
}
