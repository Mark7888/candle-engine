package templates_chartproject

import (
	"fmt"
	"github.com/google/uuid"
	"testcharting/templates/utils"
	"testcharting/templates/charts"
	"testcharting/pkg/charting/chartproject/echarts"
)

type ProjectRenderData struct {
	ProjectIndex int
	Source       string
	TradingPair  string
	// Some more stuff, like current settings
}

type LogLevelEnum string

const (
	LogLevelDebug LogLevelEnum = "DEBUG"
	LogLevelInfo  LogLevelEnum = "INFO"
	LogLevelWarn  LogLevelEnum = "WARN"
	LogLevelError LogLevelEnum = "ERROR"
)

type ProjectLogData struct {
	LogLevel      LogLevelEnum
	TimeFormatted string
	Message       string
}

templ ChartProjectLoader(index int) {
	<div hx-get={ "/project/" + fmt.Sprint(index) } hx-target="this" hx-swap="outerHTML" hx-trigger="load">
		@templates_utils.LoadingSpinner("Loading chart project...")
	</div>
}

templ ChartProject(renderData []ProjectRenderData) {
	@ProjectSettingsBar()
	@ProjectPairTabs(renderData)
}

templ ProjectSettingsBar() {
	<div class="mb-4 pb-4 border-b border-gray-200 dark:border-gray-700 pl-6">
		<div class="flex items-center gap-4">
			<span class="text-gray-500 dark:text-gray-400 font-bold">This bar is a placeholder!</span>
			<span class="text-gray-500 dark:text-gray-400 font-medium">Chart Settings:</span>
			<!-- Button -->
			<button
				class="px-4 py-2 text-sm font-medium border-2 border-transparent text-indigo-600 hover:text-indigo-700 hover:border-indigo-300 dark:text-indigo-400 dark:hover:text-indigo-300 dark:hover:border-indigo-600 rounded-md transition-colors"
			>
				Apply Settings
			</button>
			<!-- Dropdown -->
			<select
				class="px-4 py-2 text-sm font-medium border-2 border-gray-200 dark:border-gray-700 text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300 dark:hover:border-gray-600 bg-transparent transition-colors"
			>
				<option>Option 1</option>
				<option>Option 2</option>
				<option>Option 3</option>
			</select>
			<span class="text-gray-500 dark:text-gray-400 font-bold">This bar is a placeholder!</span>
		</div>
	</div>
}

templ ProjectPairTabs(renderData []ProjectRenderData) {
	{{ containerId := uuid.New().String() }}
	<div class="flex gap-4" id={ containerId }>
		<!-- Left side tabs -->
		<div class="flex flex-col space-y-2 min-w-[150px]">
			{{ i := 0 }}
			for _, data := range renderData {
				<button
					data-pair-tab
					class={ "px-4 py-2 text-left rounded-lg transition-colors", templ.KV("bg-indigo-100 text-indigo-700 dark:bg-indigo-900 dark:text-indigo-300", i == 0), templ.KV("bg-transparent text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700", i != 0) }
					onclick={ switchPairTabScript(containerId, i) }
				>
					{ data.TradingPair }
					<br/>
					<span class="text-sm text-gray-500 dark:text-gray-400">{ data.Source }</span>
				</button>
				{{ i++ }}
			}
		</div>
		<!-- Right side content -->
		<div class="flex-1">
			{{ j := 0 }}
			for _, data := range renderData {
				<div data-pair-content class={ templ.KV("hidden", j != 0) }>
					@ProjectPairRenderLoader(data)
				</div>
				{{ j++ }}
			}
		</div>
	</div>
}

templ ProjectPairRenderLoader(data ProjectRenderData) {
	<div
		class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg"
		hx-get={ "/project/" + fmt.Sprint(data.ProjectIndex) + "/render?source=" + data.Source + "&pair=" + data.TradingPair }
		hx-target="this"
		hx-swap="outerHTML"
		hx-trigger="intersect"
	>
		// TODO - url assembly is not safe, needs proper encoding
		@templates_utils.LoadingSpinner("Loading chart for " + data.TradingPair + " from " + data.Source + "...")
	</div>
}

// TODO - Make log panel scrollable independently of chart area, inside the flex container
templ ProjectPairRender(echartOptions echarts.EchartsOptions, logTemp map[string][]ProjectLogData) {
	{{ panelId := uuid.New().String() }}
	{{ selectId := uuid.New().String() }}
	<div id={ panelId } class="flex gap-2 w-full min-h-[calc(100vh-16rem)] mb-8">
		@syncLogsPanelState()
		@syncLogFilterButtonStates()
		<!-- Main Content Area (2/3) -->
		<div data-main-content class="w-full lg:w-full transition-all duration-300 flex flex-col">
			<div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 flex-1 overflow-y-auto">
				@ChartContent(echartOptions)
			</div>
		</div>
		<!-- Collapsed Logs Bar (shown by default) -->
		<div
			data-collapsed-bar
			class="w-12 min-h-full bg-gradient-to-b from-gray-100 to-gray-50 dark:from-gray-800 dark:to-gray-900 border border-gray-300 dark:border-gray-600 rounded cursor-pointer hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors flex items-center justify-center group"
			onclick={ toggleLogsPanelScript() }
			title="Open logs panel"
		>
			<svg class="w-4 h-4 text-gray-500 dark:text-gray-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
			</svg>
		</div>
		<!-- Logs Panel (1/3, hidden by default) -->
		<div data-logs-panel class="hidden lg:w-1/3 w-full transition-all duration-300 flex flex-col">
			<div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 flex-1 flex flex-col">
				<!-- Header with close button and dropdown -->
				<div class="flex items-center justify-between mb-3 pb-2 border-b border-gray-200 dark:border-gray-700 flex-shrink-0">
					<div class="flex items-center gap-3">
						<h3 class="text-lg font-medium text-gray-900 dark:text-gray-100">Logs</h3>
						<select
							id={ selectId }
							class="px-3 py-1 text-sm border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
							onchange={ onLogTypeChangeScript(panelId, selectId) }
						>
							<option value="" disabled selected>-</option>
							for logType := range logTemp {
								<option value={ logType }>{ logType }</option>
							}
						</select>
					</div>
					<button
						onclick={ toggleLogsPanelScript() }
						class="p-1 rounded hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors"
						title="Close logs panel"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<!-- Log Level Filter Buttons -->
				<div class="flex gap-2 mb-3 pb-3 border-b border-gray-200 dark:border-gray-700 flex-shrink-0">
					@LogFilterButton("DEBUG")
					@LogFilterButton("INFO")
					@LogFilterButton("WARN")
					@LogFilterButton("ERROR")
				</div>
				<!-- Logs content -->
				<div class="flex-1 overflow-y-auto min-h-0">
					<!-- Empty state when no log type selected -->
					<div data-log-empty class="flex items-center justify-center h-full text-gray-500 dark:text-gray-400">
						<span>Select a log type to view logs</span>
					</div>
					<!-- Log collections (hidden by default) -->
					for logType, logs := range logTemp {
						<div data-log-collection={ logType } class="hidden space-y-2 text-sm font-mono">
							for _, logLine := range logs {
								@LogContent(logLine)
							}
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

templ ChartContent(echartOptions echarts.EchartsOptions) {
	@templates_charts.ChartRender(echartOptions)
}

templ LogContent(logData ProjectLogData) {
	<div 
		data-log-level={ string(logData.LogLevel) }
		class={ "text-sm font-mono log-entry", templ.KV("text-red-600 dark:text-red-400", logData.LogLevel == "ERROR"), templ.KV("text-yellow-600 dark:text-yellow-400", logData.LogLevel == "WARN"), templ.KV("text-green-600 dark:text-green-400", logData.LogLevel == "INFO"), templ.KV("text-gray-600 dark:text-gray-400", logData.LogLevel != "ERROR" && logData.LogLevel != "WARN" && logData.LogLevel != "INFO") }
	>
		<span class="text-gray-500 dark:text-gray-500">[{ logData.TimeFormatted }]</span> { logData.Message }
	</div>
}

templ LogFilterButton(level string) {
	<button
		data-log-filter={ level }
		class={
			"log-filter-btn flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-all duration-200 shadow-sm",
			"[&.log-filter-inactive]:!bg-gray-100 [&.log-filter-inactive]:!text-gray-400 [&.log-filter-inactive]:opacity-50",
			"[&.log-filter-inactive]:dark:!bg-gray-800 [&.log-filter-inactive]:dark:!text-gray-600",
			templ.KV("bg-gray-200 text-gray-600 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-400 dark:hover:bg-gray-600", level == "DEBUG"),
			templ.KV("bg-green-100 text-green-700 hover:bg-green-200 dark:bg-green-900/30 dark:text-green-400 dark:hover:bg-green-900/50", level == "INFO"),
			templ.KV("bg-yellow-100 text-yellow-700 hover:bg-yellow-200 dark:bg-yellow-900/30 dark:text-yellow-400 dark:hover:bg-yellow-900/50", level == "WARN"),
			templ.KV("bg-red-100 text-red-700 hover:bg-red-200 dark:bg-red-900/30 dark:text-red-400 dark:hover:bg-red-900/50", level == "ERROR"),
		}
		onclick={ toggleLogLevelFilterScript(level) }
	>
		<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			if level == "DEBUG" {
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
			} else if level == "INFO" {
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			} else if level == "WARN" {
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
			} else if level == "ERROR" {
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			}
		</svg>
		{ level }
	</button>
}
